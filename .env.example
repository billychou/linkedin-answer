# ============================================================
# LinkedIn Answer Today — 环境变量清单
# 复制为 .env 后填写：cp .env.example .env
# 生产环境请在 Cloudflare Pages 控制台配置同名变量（见
# CLOUDFLARE_DEPLOYMENT.md 的"环境变量管理"章节）。
# ============================================================

# --- 站点与前端（NEXT_PUBLIC_* 为构建期内联变量）---
# 站点正式 URL
NEXT_PUBLIC_SITE_URL=https://example.com
# 是否启用 locale 自动检测（true/false）
NEXT_PUBLIC_LOCALE_DETECTION=false
# 是否启用优化图片（true/false）
NEXT_PUBLIC_OPTIMIZED_IMAGES=false
# Google Analytics ID（可选）
NEXT_PUBLIC_GOOGLE_ID=
# Google AdSense ID（可选）
NEXT_PUBLIC_GOOGLE_ADSENSE_ID=

# Google Identity Services OAuth client ID (Web application)。
# 在 Google Cloud Console 创建，并授权 JavaScript 来源：
# http://localhost:3000 与生产域名。
# 构建期内联进浏览器 bundle；在 Cloudflare Pages 中配置时
# 不要勾选 Encrypt（构建进程需要读取），且与 GOOGLE_CLIENT_ID 值相同。
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# --- 服务端会话鉴权（Cloudflare Pages Functions 运行时变量）---
# 与 NEXT_PUBLIC_GOOGLE_CLIENT_ID 相同，服务端校验 Google ID Token 用。
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# 会话签名密钥：openssl rand -base64 48 生成；本地与生产必须一致。
SESSION_SECRET=

# --- Stripe 计费（Phase 2，Pages Functions 运行时变量）---
# Stripe Secret Key（sk_test_ / sk_live_，Dashboard → Developers → API keys）。
STRIPE_SECRET_KEY=
# Webhook 签名密钥（whsec_，Dashboard → Developers → Webhooks → 对应端点）。
STRIPE_WEBHOOK_SECRET=

# --- 限流（Upstash Redis，可选；未配置时 fail-open）---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- 邮件（Resend，Newsletter/交易邮件，可选）---
RESEND_API_KEY=

# --- 仅本地开发（切勿在 Cloudflare 生产/Preview 中设置）---
# 允许 /api/auth/dev-login，并在 /login 显示 "Dev login" 按钮。
DEV_FAKE_LOGIN=false
NEXT_PUBLIC_DEV_FAKE_LOGIN=false
